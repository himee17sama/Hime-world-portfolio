  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-node"  // <- dossier où TypeScript mettra les fichiers compilés
  },
  "include": ["vite.config.ts", "node"]
}

